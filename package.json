{
  "name": "new-dcc-controller",
  "version": "1.0.0",
  "description": "",
  "license": "apache-2.0",
  "author": "",
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "npm run build:client && node src/index.ts",
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch-path=src --watch-path=shared src/index.ts",
    "dev:client": "vite --config client/vite.config.js",
    "build:client": "vite build --config client/vite.config.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p client/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@pixi/react": "^8.0.5",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tanstack/react-query": "^5.102.8",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "graphology": "^0.26.0",
    "graphology-shortest-path": "^2.1.0",
    "multer": "^2.1.1",
    "pixi.js": "^8.20.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "three": "^0.183.2",
    "xstate": "^5.32.6",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.2.0",
    "eslint-plugin-n": "^17.24.0",
    "globals": "^17.5.0",
    "graphology-types": "^0.24.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
